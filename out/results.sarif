          "rules": [
            {
              "id": "py-rsa-crypto",
              "name": "py_rsa_crypto",
              "shortDescription": {
                "text": "py-rsa-crypto"
              },
              "fullDescription": {
                "text": "cryptography.io RSA API"
              },
              "help": {
                "text": "Classical public-key scheme vulnerable to Shor's algorithm; plan migration to NIST PQC (ML-KEM / ML-DSA / SLH-DSA) for long-term trust."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "pqc",
                  "quantum"
                ],
                "problem.severity": "high"
              }
            },
